{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shipwelldev/cornerstone",
    "type": "project",
    "description": "A highly opinionated Laravel Livewire starter kit by Ship Well Development.",
    "keywords": [
        "laravel",
        "livewire",
        "starter-kit"
    ],
    "homepage": "https://github.com/shipwelldev/cornerstone",
    "license": "MIT",
    "authors": [
        {
            "name": "Ship Well Development",
            "homepage": "https://shipwell.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/shipwelldev/cornerstone/issues",
        "source": "https://github.com/shipwelldev/cornerstone"
    },
    "require": {
        "glhd/bits": "^0.6",
        "laravel/framework": "^13.20",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "php": "~8.4.1 || ~8.5.0",
        "shipwelldev/cornerstone-support": "^0.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "build": [
            "npm run build"
        ],
        "configure-boost": [
            "@php scripts/Setup.php configure-boost"
        ],
        "fix": [
            "@php vendor/bin/pint --format agent"
        ],
        "pest": [
            "@php artisan test --compact"
        ],
        "pint": [
            "@php vendor/bin/pint --format agent"
        ],
        "prepare-environment": [
            "@php scripts/Setup.php prepare-environment"
        ],
        "install-boost": [
            "@php scripts/Setup.php install-boost"
        ],
        "setup": [
            "@composer install --no-interaction --prefer-dist @no_additional_args",
            "@prepare-environment",
            "@install-boost",
            "@configure-boost",
            "npm ci @no_additional_args",
            "npx playwright install chromium @no_additional_args",
            "npm run build @no_additional_args"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@test:application",
            "@test:browser"
        ],
        "test:application": [
            "@php artisan test --ci --parallel --compact --exclude-testsuite=Browser"
        ],
        "test:browser": [
            "@php scripts/RunBrowserTests.php"
        ],
        "verify": [
            "@php vendor/bin/pint --test --format agent",
            "@analyse",
            "@build",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php scripts/Setup.php update-boost"
        ],
        "post-root-package-install": [
            "@php scripts/Setup.php copy-environment"
        ],
        "post-create-project-cmd": [
            "@composer update shipwelldev/cornerstone-support --no-interaction @no_additional_args",
            "@php artisan cornerstone:stubs --ansi --no-interaction @no_additional_args",
            "@setup @no_additional_args"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
